{
  "name": "@logionos/openclaw-shield",
  "version": "0.1.0",
  "description": "Enterprise compliance layer for OpenClaw — PII protection, audit trails, and regulatory compliance for AI agents",
  "license": "Apache-2.0",
  "author": "LogionOS Inc.",
  "homepage": "https://logionos.com/shield",
  "repository": {
    "type": "git",
    "url": "https://github.com/LogionOS/openclaw-shield"
  },
  "keywords": [
    "openclaw",
    "compliance",
    "ai-safety",
    "pii-detection",
    "audit-trail",
    "gdpr",
    "eu-ai-act"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "install": {
      "npmSpec": "@logionos/openclaw-shield",
      "defaultChoice": "npm"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
